# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Public URL telephony providers call back to (use an ngrok tunnel in dev)
PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- LLM ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Speech ---
STT_PROVIDER=google
TTS_PROVIDER=google
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Persistence ---
DATABASE_URL=sqlite:///./var/appointments.db
